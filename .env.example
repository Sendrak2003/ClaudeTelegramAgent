# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ должен попадать в git (см. .gitignore).

# ==== Telegram ====
# Токен бота, полученный у @BotFather.
Telegram__BotToken=

# ==== Claude Code CLI ====
# Рабочая папка, в которой запускается `claude` (там же будут храниться
# .agent-data/sessions.json и .agent-data/reminders.db, если пути ниже не заданы явно).
# В Docker-варианте это путь ВНУТРИ контейнера, например /workspace.
Claude__WorkDir=/workspace

# Имя/путь исполняемого файла claude CLI.
Claude__Bin=claude

# Режим разрешений claude CLI: acceptEdits | bypassPermissions | default | plan и т.д.
# bypassPermissions добавляет флаг --dangerously-skip-permissions — используйте осторожно.
Claude__PermissionMode=acceptEdits

# Таймаут одного вызова claude CLI в секундах.
Claude__TimeoutSeconds=300

# Способ авторизации: subscription (использует `claude login`, ANTHROPIC_API_KEY не передаётся)
# или apikey (использует ключ из Claude__ApiKey).
Claude__AuthMode=subscription

# Ключ Anthropic API — нужен только если Claude__AuthMode=apikey.
Claude__ApiKey=

# ==== Reminders (напоминания) ====
# Путь к SQLite-базе напоминаний для основного веб-хоста.
# По умолчанию — {Claude__WorkDir}/.agent-data/reminders.db, можно переопределить явно.
Reminders__DbPath=

# Как часто (в секундах) проверять просроченные напоминания.
Reminders__PollSeconds=30

# ==== Agent ====
# IANA-имя часового пояса пользователя, например Europe/Moscow, Europe/Berlin, UTC.
Agent__TimeZone=Europe/Moscow

# Список Telegram user id, которым разрешено пользоваться ботом, через запятую.
# Это единственная защита от посторонних пользователей — оставлять пустым нельзя.
# Узнать свой user id можно, например, у бота @userinfobot.
Agent__AllowedUserIds=

# ==== RemindersMcpServer ====
# Тот же MCP-сервер запускается claude CLI отдельным процессом на каждый вызов инструмента,
# поэтому ему нужны свои переменные окружения БЕЗ "__" (см. deploy/mcp.json*.example).
# Обычно REMINDERS_DB совпадает с Reminders__DbPath, а AGENT_TIMEZONE — с Agent__TimeZone.
REMINDERS_DB=/workspace/.agent-data/reminders.db
AGENT_TIMEZONE=Europe/Moscow
